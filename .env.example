# NatureLens AI - Environment Configuration Example
# Copy this file to .env for local overrides

# Flask Application Settings
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Google Gemini AI Settings (Official google-genai SDK)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_new_api_key_here
# Multimodal model supporting vision analysis and text generation:
GEMINI_MODEL=gemini-2.5-flash
# Fallback Gemini model:
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Local Ollama AI Settings (Open-Weight Models - Alternative / Fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Primary Vision-Language Model: e.g. llama3.2-vision:11b, qwen2.5-vl:7b, minicpm-v
OLLAMA_VISION_MODEL=llama3.2-vision:11b
# Lightweight fallback if primary is too heavy for host GPU/VRAM: e.g. llava:7b, moondream
OLLAMA_VISION_MODEL_FALLBACK=llava:7b
# Text Model for Nature Guide and Missions: e.g. llama3.2:3b, qwen2.5:3b, mistral:7b
OLLAMA_TEXT_MODEL=llama3.2:3b
# Timeout for inference (in seconds)
OLLAMA_TIMEOUT_SECONDS=35

# Fallback & Demo Mode (True enables educational mock cards when AI is offline or quota reached)
DEMO_MODE_ALLOWED=true

# Storage and Database (Defaults to SQLite in ./instance/naturelens.db)
# DATABASE_URL=sqlite:///instance/naturelens.db
# UPLOAD_FOLDER=uploads
